# Development substitutions only. Never use these values in production.
DATABASE_URL=postgresql://postgres:replace-me-locally@localhost:5432/graphic_chart_dev
R2_ACCOUNT_ID=replace-me-locally
R2_ACCESS_KEY_ID=replace-me-locally
R2_SECRET_ACCESS_KEY=replace-me-locally
R2_BUCKET=graphic-chart-local
# Optional S3-compatible origin replacing R2: the local emulator (`pnpm dev:storage`) or Google Cloud Storage
# (https://storage.googleapis.com, HMAC keys). Bare origin only; plain http only on localhost.
R2_ENDPOINT=http://127.0.0.1:9000
AI_PROVIDER=gemini
AI_MODEL=replace-me-locally
AI_API_KEY=replace-me-locally
AI_DAILY_BUDGET_EUR=5
AI_USER_DAILY_TOKENS=1000
AUTH_SECRET=replace-with-a-random-local-value
APP_URL=http://localhost:3000
# Cloudflare's public Turnstile test keys: always pass, invisible (developers.cloudflare.com/turnstile/troubleshooting/testing).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000BB
EMAIL_API_KEY=replace-me-locally
EMAIL_FROM="Atelier Graphic Chart <noreply@example.invalid>"
SENTRY_DSN=https://public@example.invalid/1
INTERNAL_PRINT_SECRET=replace-with-a-random-local-value
POSTGRES_PASSWORD=replace-me-locally
