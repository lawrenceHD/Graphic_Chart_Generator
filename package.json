{
  "name": "atelier-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "deps:check": "depcruise --config .dependency-cruiser.cjs apps packages",
    "verify": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run deps:check",
    "logos:fetch": "node tools/logo-library/fetch.mjs",
    "corpus:fetch": "node tools/corpus/fetch-private.mjs",
    "dev:storage": "node tools/dev-storage/server.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "18.5.0",
    "eslint": "9.22.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
